# ============================================================================
# 无人仓系统 · 忽略规则
# 原则：凡是"能自动生成"或"不该公开"的，都不入库
# ============================================================================

# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# ---- 密钥与本地配置（严禁入库）----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
*.local.yaml
*.local.yml
*.local.json
config/local.*

# ---- Node / 前端 ----
node_modules/
.pnpm-store/
dist/
build/
out/
.next/
.nuxt/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Python / 后端 ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
htmlcov/
.coverage
.coverage.*

# ---- 运行期数据与日志 ----
logs/
*.log
tmp/
temp/
.cache/
data/raw/
data/processed/
!data/README.md

# ---- 本地数据库（现场数据不入库，只入样例）----
*.db
*.db-journal
*.sqlite
*.sqlite3
*.mdb
!test/fixtures/*.db

# ---- 模型权重 / 点云 / 录包（体积大，走 Git LFS 或项目网盘）----
*.pt
*.pth
*.onnx
*.engine
*.trt
*.bag
*.pcd
*.ply
*.las

# ---- 现场素材：视频、长录屏、现场照片（放项目网盘）----
*.mp4
*.mov
*.avi
*.mkv

# ---- 压缩包与安装包 ----
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.exe
*.msi

# ---- 构建与工具缓存 ----
.codebuddy/
.turbo/
.eslintcache
.stylelintcache

# ---- Office 临时文件（文档主副本在项目网盘，仓库只放定稿）----
~$*.docx
~$*.xlsx
~$*.pptx
