root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{java,kt,kts,cs}]
indent_size = 4

[*.{js,jsx,mjs,cjs,ts,tsx,vue,json,jsonc,yml,yaml,html,css,scss,less,md}]
indent_size = 2

[*.{ps1,psm1,bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
